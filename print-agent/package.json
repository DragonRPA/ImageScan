{
  "name": "zebra-print-agent",
  "version": "1.1.0",
  "description": "Zebra GK-420D PC Local Print Agent - Supabase print_queue ZPL 자동 출력",
  "main": "zebra-agent.cjs",
  "bin": "zebra-agent.cjs",
  "scripts": {
    "start": "node zebra-agent.cjs",
    "start:dev": "node --watch zebra-agent.cjs",
    "build": "npx pkg zebra-agent.cjs --target node18-win-x64 --output dist/zebra-agent.exe"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist",
    "assets": [],
    "scripts": []
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "iconv-lite": "^0.7.3",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
