# ============================================================
# Zebra Print Agent - 외부 설정 파일 (agent.env)
# ============================================================
# 이 파일은 메모장(Notepad)으로 수정하고 에이전트를 재시작하면 됩니다.
# zebra-agent.exe 를 재컴파일할 필요가 없습니다.
#
# 규칙:
#   - #으로 시작하는 줄은 주석 (무시됨)
#   - 빈 값(KEY=)이면 기본값 사용
#   - 값에 따옴표 불필요 (자동 제거됨)
# ============================================================

# ── Supabase 연결 정보 ──────────────────────────────────────
# 아래 값은 기본 내장값. 변경이 필요한 경우에만 수정하세요.
SUPABASE_URL=https://tfgbpgutxxlhqbzewkyt.supabase.co
SUPABASE_KEY=sb_publishable_wruJQfp3Op-ISvVwb4ZdmA_2OqMUJeQ

# ── 프린터 직접 지정 (선택 사항) ────────────────────────────
# 비워두면 agent-config.json 의 저장값을 사용합니다.
# 값을 채우면 agent-config.json 보다 이 값이 우선 적용됩니다.
PRINTER_HOST=
PRINTER_PORT=9100

# ── 기타 설정 ───────────────────────────────────────────────
# Realtime 재연결 대기시간 (밀리초, 기본 5000 = 5초)
RECONNECT_MS=5000
